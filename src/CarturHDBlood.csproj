<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>CarturHDBlood</AssemblyName>
    <!-- Keep in step with the version in [BepInPlugin] - Thunderstore reads the
         manifest, BepInEx reads the attribute, and a mismatch shows users two
         different numbers for the same build. -->
    <Version>1.0.0</Version>
    <LangVersion>latest</LangVersion>
    <RestoreAdditionalProjectSources>https://nuget.bepinex.dev/v3/index.json</RestoreAdditionalProjectSources>
    <!-- Managed DLLs come from the raw Steam install -->
    <VALHEIM_INSTALL Condition="'$(VALHEIM_INSTALL)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Valheim</VALHEIM_INSTALL>
    <!-- Actual play happens through r2modman's Default profile - deploy the built DLL there -->
    <R2MODMAN_PROFILE Condition="'$(R2MODMAN_PROFILE)' == ''">$(APPDATA)\r2modmanPlus-local\Valheim\profiles\Default</R2MODMAN_PROFILE>

    <!-- Hot reload. `dotnet build -p:HOT_RELOAD=true` deploys to BepInEx\scripts instead of
         plugins, where BepInEx's ScriptEngine reloads the assembly in-memory on F6 rather than
         needing a game restart.

         Off by default on purpose: a scripts deploy with ScriptEngine absent means the mod
         simply never loads, and a silent no-op is a worse default than an extra restart.

         The DLL must be in exactly ONE of the two folders. In both, it loads twice - two sets of
         Harmony patches on the same methods, and every effect skinned and grafted twice. -->
    <HOT_RELOAD Condition="'$(HOT_RELOAD)' == ''">false</HOT_RELOAD>
    <DeployDir Condition="'$(HOT_RELOAD)' == 'true'">$(R2MODMAN_PROFILE)\BepInEx\scripts</DeployDir>
    <DeployDir Condition="'$(HOT_RELOAD)' != 'true'">$(R2MODMAN_PROFILE)\BepInEx\plugins\CarturHDBlood</DeployDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.0.8" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.4.21" />
    <PackageReference Include="HarmonyX" Version="2.10.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Stay PNGs rather than raw pixel dumps: they're decoded via reflection on LoadImage,
         which avoids referencing the ReadOnlySpan<byte> overload set at compile time
         (CS0518 under net472 against this game's netstandard.dll). -->
    <!-- One image per material, sized to the world size that material actually draws at, which
         is how vanilla assigns particle textures in the first place - it never samples a sheet.
         Every asset must be listed here individually; there is no wildcard, and forgetting one
         fails at RUNTIME rather than at build.

         Ground decals draw 0.5-8 world units, so the two large marks are 1024 and the small
         one is 512. Nothing else ships: the airborne blood is vanilla again, and the grafted
         cloud deliberately uses the game's own blood_cloud texture. -->
    <EmbeddedResource Include="Assets\splatter_spray_1024_rgba.png">
      <LogicalName>CarturHDBlood.splatter_spray_1024_rgba.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Assets\splatter_mist_1024_rgba.png">
      <LogicalName>CarturHDBlood.splatter_mist_1024_rgba.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Assets\splatter_impact_512_rgba.png">
      <LogicalName>CarturHDBlood.splatter_impact_512_rgba.png</LogicalName>
    </EmbeddedResource>

    <!-- Normal maps, one per ground mark, same size as the diffuse it pairs with.
         Custom/ParticleDecal has a live _NormalTex - vanilla puts brains_n 64x64 there - so the
         ground decals ARE lit. Without these they were lit by the bumps of vanilla's blob while
         drawing our splatter, which is why the blood read flat rather than wet. -->
    <EmbeddedResource Include="Assets\splatter_spray_1024_normal.png">
      <LogicalName>CarturHDBlood.splatter_spray_1024_normal.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Assets\splatter_mist_1024_normal.png">
      <LogicalName>CarturHDBlood.splatter_mist_1024_normal.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Assets\splatter_impact_512_normal.png">
      <LogicalName>CarturHDBlood.splatter_impact_512_normal.png</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="assembly_valheim">
      <HintPath>$(VALHEIM_INSTALL)\valheim_Data\Managed\assembly_valheim.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_utils">
      <HintPath>$(VALHEIM_INSTALL)\valheim_Data\Managed\assembly_utils.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(VALHEIM_INSTALL)\valheim_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(VALHEIM_INSTALL)\valheim_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- ParticleSystem, its module structs, and ParticleSystemRenderer all live here. The whole
         probe is about reading those, so this reference is the load-bearing one. -->
    <!-- Physics.Raycast, used to find the ground under a kill so a pool lies on the surface. -->
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(VALHEIM_INSTALL)\valheim_Data\Managed\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ParticleSystemModule">
      <HintPath>$(VALHEIM_INSTALL)\valheim_Data\Managed\UnityEngine.ParticleSystemModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Auto-deploy built DLL into the r2modman profile BepInEx actually loads -->
  <Target Name="DeployToPlugins" AfterTargets="Build">
    <ItemGroup>
      <DeployFiles Include="$(TargetDir)$(AssemblyName).dll" />
    </ItemGroup>
    <MakeDir Directories="$(DeployDir)" />
    <Copy SourceFiles="@(DeployFiles)" DestinationFolder="$(DeployDir)" />
    <Message Importance="high" Text="Deployed to $(DeployDir)" />
  </Target>

</Project>
